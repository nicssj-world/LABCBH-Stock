NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Production Lab Management Portal Supabase (server-only). Set both values
# when the Stock production database is different from the Portal database.
# Never use NEXT_PUBLIC_* for the service-role key.
LAB_MANAGEMENT_PORTAL_SUPABASE_URL=https://portal-project.supabase.co
LAB_MANAGEMENT_PORTAL_SUPABASE_SERVICE_ROLE_KEY=your-portal-service-role-key

# Local PostgreSQL backup runner. Keep these values on the trusted runner only;
# never add them to NEXT_PUBLIC_* or expose them to the browser.
BACKUP_DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres?sslmode=require
BACKUP_EXPECTED_PROJECT_REF=your-project-ref
BACKUP_ROOT=.backups
BACKUP_RUNNER_ID=labcbh-stock-runner-01
# Optional: absolute path when pg_dump is not available on PATH.
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\17\bin\pg_dump.exe

# Private Cloudflare R2 bucket for mandatory PR checklist files.
# Use a bucket-scoped Object Read & Write token; never expose these to the browser.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-private-r2-bucket

# Preview/staging-only Playwright fixtures. Never point mutation tests at production.
E2E_BASE_URL=https://your-preview.vercel.app
E2E_REQUIRE_FIXTURES=0
E2E_ALLOW_MUTATIONS=0
E2E_ADMIN_IDENTIFIER=9495
E2E_ADMIN_PASSWORD=admin-password
E2E_MANAGER_IDENTIFIER=manager-ephis-id
E2E_MANAGER_PASSWORD=manager-password
E2E_STOCK_IDENTIFIER=14812
E2E_STOCK_PASSWORD=stock-password
E2E_STOCK_ALT_IDENTIFIER=11050
E2E_STOCK_ALT_PASSWORD=second-stock-password
E2E_PR_READY_URL=/purchase-requests/fixture-id
E2E_RECEIPT_DRAFT_URL=/receipts/fixture-id
E2E_REQUISITION_WAITING_URL=/requisitions/fixture-id
E2E_LEASE_CONTRACT_URL=/contracts/fixture-id

# LINE OA notification (server-only; configure Staging/Production only)
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_GROUP_ID=your-line-group-id
APP_BASE_URL=https://your-production-domain.example
CRON_SECRET=your-random-cleanup-secret
